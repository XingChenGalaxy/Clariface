<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:id="@+id/splashCenterGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:foregroundGravity="center">

            <View
                android:id="@+id/splashGlow"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:background="@drawable/bg_splash_glow_ring" />

            <ImageView
                android:id="@+id/splashIcon"
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/clariface_icon" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Clariface"
            android:textColor="@color/splash_gold"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

