<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/bg_overlay_card"
    android:elevation="10dp"
    android:minWidth="220dp"
    android:orientation="vertical"
    android:padding="14dp"
    tools:ignore="SmallSp"
    tools:showIn="@layout/preview_overlay_metrics"
    tools:theme="@style/Theme.MyApplication">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlayStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_running"
            android:maxLines="3"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/overlay_detecting_now"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="正在检测" />

        <ImageButton
            android:id="@+id/overlayOpenAppIconButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_status_running"
            android:contentDescription="@string/overlay_back_to_app"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_overlay_home"
            android:tint="@color/white"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlayMetricsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlayProbabilityText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/overlay_probability_default"
            android:textColor="@color/overlay_title_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="概率: 0.9523" />

        <TextView
            android:id="@+id/overlayFpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_fps_default"
            android:textColor="@color/overlay_body_text"
            android:textSize="13sp"
            tools:text="FPS: 58.9" />

        <TextView
            android:id="@+id/overlayLatencyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_latency_default"
            android:textColor="@color/overlay_body_text"
            android:textSize="13sp"
            tools:text="耗时: 17 ms" />

        <Button
            android:id="@+id/overlayOpenAppButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/bg_status_running"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/overlay_back_to_app"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlayDragHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/overlay_drag_hint"
        android:textColor="@color/overlay_hint_text"
        android:textSize="10sp" />

</LinearLayout>
