<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_overlay_card"
    android:elevation="6dp"
    android:minWidth="210dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/overlayStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_running"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/overlay_detecting_now"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/overlayMetricsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlayProbabilityText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/overlay_probability_default"
            android:textColor="@color/overlay_title_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayFpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_fps_default"
            android:textColor="@color/overlay_body_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/overlayLatencyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_latency_default"
            android:textColor="@color/overlay_body_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/overlayLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_label_default"
            android:textColor="@color/overlay_body_text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/overlay_drag_hint"
        android:textColor="@color/overlay_hint_text"
        android:textSize="10sp" />

</LinearLayout>


